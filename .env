# ── Pucho AI Studio Workflow Webhooks ───────────────────────────────────────

# WF-P: Slot Report Email — generates & emails monthly slot analysis CSV
# Trigger: POST { month, year, monthName, recipients[], template }
# Gated behind: report_verifications table (must verify before sending)
VITE_PUCHO_WF_SLOT_REPORT=https://studio.pucho.ai/api/v1/webhooks/r09sAQgX83zo5Nu3toQOy

# WF-M: Absence Alert Engine — detects absent students & notifies parents via email
# Trigger: POST {} (reads platform_settings for delay config)
# Runs: Cron every 30 minutes during academy hours
# Sends: One personalized HTML email per absent student's parent
VITE_PUCHO_WF_ABSENCE_ALERT=https://studio.pucho.ai/api/v1/webhooks/DopWnr6b49mgNZzHA0vEk

# WF-O: Payment Reminder Email — sends payment reminders to parents with pending balance
VITE_PUCHO_WF_PAYMENT_REMINDER=https://studio.pucho.ai/api/v1/webhooks/eZJfKQH1ekOFsvgMhwD5b

# WF-I: Direct Payment Capture — processes payment webhooks & updates package status
VITE_PUCHO_WF_PAYMENT_CAPTURE=https://studio.pucho.ai/api/v1/webhooks/E2SD78RX1bFBGKOS9CVia

# WF-J: Club Excel Reconciliation — processes uploaded club attendance/payment excel sheets
VITE_PUCHO_WF_RECONCILIATION=https://studio.pucho.ai/api/v1/webhooks/4E19IBEoWuQg1ZDTx2m2N

