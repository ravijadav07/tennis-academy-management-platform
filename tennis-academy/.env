# ============================================================================
# Tennis Academy Management — Environment Variables
# ============================================================================
# IMPORTANT: This file contains credentials. NEVER commit this file to git.
# Use .env.example as the template for new developers.
# ============================================================================

# ── Pucho AI Studio Workflow Webhooks ───────────────────────────────────────

# WF-P: Slot Report Email — generates & emails monthly slot analysis CSV
# Trigger: POST { month, year, monthName, recipients[], template }
# Gated behind: report_verifications table (must verify before sending)
VITE_PUCHO_WF_SLOT_REPORT=https://studio.pucho.ai/api/v1/webhooks/oDhZcxVjs9KnbzBmq50Ks

# WF-M: Absence Alert Engine — detects absent students & notifies parents via email
# Trigger: POST {} (reads platform_settings for delay config)
# Runs: Cron every 30 minutes during academy hours
# Sends: One personalized HTML email per absent student's parent
VITE_PUCHO_WF_ABSENCE_ALERT=https://studio.pucho.ai/api/v1/webhooks/oTllVVNo2MQXW1DFJ0dcR

# WF-O: Payment Reminder Email — sends payment reminders to parents with pending balance
VITE_PUCHO_WF_PAYMENT_REMINDER=https://studio.pucho.ai/api/v1/webhooks/w71ZODkbzBSiG1UMApRiv

# WF-I: Direct Payment Capture — processes payment webhooks & updates package status
VITE_PUCHO_WF_PAYMENT_CAPTURE=https://studio.pucho.ai/api/v1/webhooks/SdtXcDqzbXQo6ChmEo4rj

# WF-J: Club Excel Reconciliation — processes uploaded club attendance/payment excel sheets
VITE_PUCHO_WF_RECONCILIATION=https://studio.pucho.ai/api/v1/webhooks/EnY4QZQpvqenJfctu1taZ

# WF-E: Course Completion & Certificate — triggers course completion & certificate generation
VITE_PUCHO_WF_COURSE_COMPLETION=https://studio.pucho.ai/api/v1/webhooks/ShPSpbE2nejxQJIgsKPrX

# WF-D: Student Onboarding — triggers onboarding sequence for newly enrolled students
VITE_PUCHO_WF_STUDENT_ONBOARDING=https://studio.pucho.ai/api/v1/webhooks/6jb1H2fZCMFfRKREkFilm

# WF-L: Coach Leave & Payroll — processes coach leave applications
VITE_PUCHO_WF_COACH_LEAVE=https://studio.pucho.ai/api/v1/webhooks/FZYT8yTSDGrF3whkfhE97
VITE_PUCHO_WF_COACH_PAYROLL=https://studio.pucho.ai/api/v1/webhooks/FZYT8yTSDGrF3whkfhE97

# WF-K: Invoice & Occupancy Report — generates invoice & occupancy reports
VITE_PUCHO_WF_INVOICE_OCCUPANCY=https://studio.pucho.ai/api/v1/webhooks/WSFxxzlcpTttJj55o541F
VITE_PUCHO_WF_INVOICE_REPORT=https://studio.pucho.ai/api/v1/webhooks/WSFxxzlcpTttJj55o541F

# WF-F: Daily 1-on-1 Session Confirmation — Scheduled trigger (Cron 8 AM Daily, no webhook needed)

# ── Supabase Configuration ──────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── App Configuration ───────────────────────────────────────────────────────

VITE_APP_NAME=Tennis Academy Management
VITE_APP_URL=http://localhost:5173
VITE_GST_RATE=0.18

# ── Deployment ──────────────────────────────────────────────────────────────
