# ============================================================================
# Tennis Academy Management — Environment Variables
# ============================================================================
# IMPORTANT: This file contains credentials. NEVER commit this file to git.
# Use .env.example as the template for new developers.
# ============================================================================

# ── Pucho AI Studio Workflow Webhooks ───────────────────────────────────────

# WF-P: Slot Report Email — generates & emails monthly slot analysis CSV
# Trigger: POST { month, year, monthName, recipients[], template }
# Gated behind: report_verifications table (must verify before sending)
VITE_PUCHO_WF_SLOT_REPORT=https://studio.pucho.ai/api/v1/webhooks/oDhZcxVjs9KnbzBmq50Ks

# WF-M: Absence Alert Engine — detects absent students & notifies parents via email
# Trigger: POST {} (reads platform_settings for delay config)
# Runs: Cron every 30 minutes during academy hours
# Sends: One personalized HTML email per absent student's parent
VITE_PUCHO_WF_ABSENCE_ALERT=https://studio.pucho.ai/api/v1/webhooks/oTllVVNo2MQXW1DFJ0dcR

# WF-O: Payment Reminder Email — sends payment reminders to parents with pending balance
# Trigger: POST {} (one parent per invocation)
# Sends: LLM-generated personalized email per parent
VITE_PUCHO_WF_PAYMENT_REMINDER=https://studio.pucho.ai/api/v1/webhooks/w71ZODkbzBSiG1UMApRiv

# ── Supabase Configuration ──────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── App Configuration ───────────────────────────────────────────────────────

VITE_APP_NAME=Tennis Academy Management
VITE_APP_URL=http://localhost:5173
VITE_GST_RATE=0.18

# ── Deployment ──────────────────────────────────────────────────────────────
# VITE_APP_URL=https://your-production-domain.com