                      "sourceCode": {
                        "code": "export const code = async (inputs) => {\n  const batches = Array.isArray(inputs.batches_json) ? inputs.batches_json : [];\n  const enrollments = Array.isArray(inputs.enrollments_json) ? inputs.enrollments_json : [];\n  const attendance = Array.isArray(inputs.attendance_json) ? inputs.attendance_json : [];\n  const trigger = inputs.trigger_body || {};\n\n  const monthName = trigger.monthName || trigger.month || '';\n  const year = trigger.year || new Date().getFullYear();\n  const recipients = Array.isArray(trigger.recipients) ? trigger.recipients : (trigger.recipients ? [trigger.recipients] : []);\n  const template = trigger.template || {};\n\n  const rawSub = (template.subject || 'Slot Analysis & Occupancy Report — {month} {year}').replace('{month}', monthName).replace('{year}', year);\n  const subject = rawSub.replace(/Arnav Jain Tennis Academy/gi, 'TOTS Tennis Academy');\n\n  // Normalize batch capacities & patterns\n  const normBatches = batches.filter(b => (b.status || '').toLowerCase() === 'active' || !b.status).map(b => ({\n    ...b,\n    capacity: Number(b.capacity || b.maxCapacity || b.max_capacity || 0),\n    dayPattern: b.dayPattern || b.daysOfWeek || b.days_of_week || b.day_pattern || '',\n    program: b.program || b.category || 'General'\n  }));\n\n  const totalBatches = normBatches.length;\n  const enrolledCount = enrollments.length;\n  const attendedCount = attendance.filter(a => String(a.status).toLowerCase() === 'present').length;\n  const totalCapacity = normBatches.reduce((s, b) => s + b.capacity, 0);\n  const occupancy = totalCapacity > 0 ? Math.round((enrolledCount / totalCapacity) * 100) : 0;\n  const openSlots = Math.max(0, totalCapacity - enrolledCount);\n\n  // Group by program category\n  const categories = ['ADV', 'INT', 'ADULT', 'GREEN', 'ORANGE', 'RED', 'WEEKEND', 'FITNESS'];\n  const programMetrics = {};\n  categories.forEach(cat => {\n    const catBatches = normBatches.filter(b => b.program === cat);\n    const catCap = catBatches.reduce((s, b) => s + b.capacity, 0);\n    const catEnr = enrollments.filter(e => catBatches.some(b => b.id === e.batch_id || b.id === e.batchId)).length;\n    const catOpen = Math.max(0, catCap - catEnr);\n    const catOcc = catCap > 0 ? Math.round((catEnr / catCap) * 100) : 0;\n    programMetrics[cat] = { cap: catCap, enr: catEnr, open: catOpen, occ: catOcc, count: catBatches.length };\n  });\n\n  let categoryTableRows = '';\n  categories.forEach(cat => {\n    const m = programMetrics[cat];\n    if (m.count > 0 || m.cap > 0) {\n      categoryTableRows += `<tr style=\"border-bottom: 1px solid #f1f5f9;\"><td style=\"padding: 10px 12px; font-weight: 600; color: #0f172a;\">${cat}</td><td style=\"padding: 10px 12px; text-align: center; color: #334155;\">${m.cap}</td><td style=\"padding: 10px 12px; text-align: center; font-weight: 600; color: #16a34a;\">${m.enr}</td><td style=\"padding: 10px 12px; text-align: center; font-weight: 600; color: #ea580c;\">${m.open}</td><td style=\"padding: 10px 12px; text-align: right; font-weight: 700; color: #0284c7;\">${m.occ}%</td></tr>`;\n    }\n  });\n\n  let csv = 'Day/Pattern,Court & Time,Category,Capacity,Enrolled,Attended,Members,Non-members,Guest/Trial,Occupancy %\\n';\n  normBatches.forEach(b => {\n    const bEnr = enrollments.filter(e => e.batch_id === b.id || e.batchId === b.id).length;\n    const bAtt = attendance.filter(a => (a.batch_id === b.id || a.batchId === b.id) && String(a.status).toLowerCase() === 'present').length;\n    const bOcc = b.capacity > 0 ? Math.round((bEnr / b.capacity) * 100) : 0;\n    csv += `${b.dayPattern},${b.court_id || b.courtId || ''} ${b.start_time || b.startTime || ''}-${b.end_time || b.endTime || ''},${b.program},${b.capacity},${bEnr},${bAtt},${bEnr},0,0,${bOcc}%\\n`;\n  });\n\n  const htmlBody = `<div style=\"max-width: 680px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; font-family: 'Segoe UI', Arial, sans-serif; color: #1e293b; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);\"><div style=\"background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 28px 24px; text-align: center;\"><h2 style=\"color: #38bdf8; margin: 0; font-size: 24px; font-weight: 800; letter-spacing: -0.5px;\">TOTS Tennis Academy</h2><p style=\"color: #94a3b8; margin: 6px 0 0 0; font-size: 14px; font-weight: 500;\">Verified Slot Analysis & Occupancy Report — ${monthName} ${year}</p><div style=\"display: inline-block; margin-top: 12px; padding: 4px 12px; background-color: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 20px; color: #4ade80; font-size: 11px; font-weight: 700; text-transform: uppercase;\">✓ Management Audit Verified</div></div><div style=\"padding: 24px;\"><div style=\"display: flex; justify-content: space-between; gap: 12px; margin-bottom: 24px; background-color: #f8fafc; padding: 16px; border-radius: 10px; border: 1px solid #e2e8f0;\"><div style=\"text-align: center; flex: 1;\"><div style=\"font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase;\">Total Capacity</div><div style=\"font-size: 20px; font-weight: 800; color: #0f172a; margin-top: 4px;\">${totalCapacity}</div></div><div style=\"text-align: center; flex: 1;\"><div style=\"font-size: 11px; font-weight: 600; color: #16a34a; text-transform: uppercase;\">Booked Slots</div><div style=\"font-size: 20px; font-weight: 800; color: #16a34a; margin-top: 4px;\">${enrolledCount}</div></div><div style=\"text-align: center; flex: 1;\"><div style=\"font-size: 11px; font-weight: 600; color: #ea580c; text-transform: uppercase;\">Open Slots</div><div style=\"font-size: 20px; font-weight: 800; color: #ea580c; margin-top: 4px;\">${openSlots}</div></div><div style=\"text-align: center; flex: 1;\"><div style=\"font-size: 11px; font-weight: 600; color: #0284c7; text-transform: uppercase;\">Occupancy %</div><div style=\"font-size: 20px; font-weight: 800; color: #0284c7; margin-top: 4px;\">${occupancy}%</div></div></div><h3 style=\"margin: 0 0 12px 0; font-size: 15px; color: #0f172a; font-weight: 700;\">Executive Program Breakdown</h3><table style=\"width: 100%; font-size: 13px; border-collapse: collapse; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; margin-bottom: 24px;\"><thead><tr style=\"background-color: #f1f5f9; color: #475569; text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;\"><th style=\"padding: 10px 12px;\">Category</th><th style=\"padding: 10px 12px; text-align: center;\">Capacity</th><th style=\"padding: 10px 12px; text-align: center;\">Booked</th><th style=\"padding: 10px 12px; text-align: center;\">Open</th><th style=\"padding: 10px 12px; text-align: right;\">Occupancy %</th></tr></thead><tbody>${categoryTableRows}</tbody></table><div style=\"background-color: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 14px; font-size: 12px; color: #1e40af; line-height: 1.5;\"><strong>Attached Report:</strong> Full CSV schedule detailing all ${totalBatches} active batches with court assignments, time slots, member vs guest breakdown, and occupancy metrics is attached to this email (${monthName}-${year}.csv).</div></div><div style=\"background-color: #f8fafc; padding: 16px 24px; text-align: center; font-size: 12px; color: #64748b; border-top: 1px solid #e2e8f0;\"><p style=\"margin: 0;\">© TOTS Tennis Academy. Official Verified Management Audit Report.</p></div></div>`;\n\n  return { recipients: recipients.join(','), subject, body: htmlBody, body_type: 'html', csvContent: csv, recipientCount: recipients.length };\n};",
                        "packageJson": "{}"
                      },
