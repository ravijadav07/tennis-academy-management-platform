                            "missed_json": "{{step_5}}",
                            "students_json": "{{step_6}}",
                            "sp_json": "{{step_7}}",
                            "parents_json": "{{step_8}}"
                          },
                          "sourceCode": {
                            "code": "export const code = async (inputs) => {\n  const missedResult = typeof inputs.missed_json === 'string' ? JSON.parse(inputs.missed_json) : (inputs.missed_json || {});\n  const missedSessions = missedResult.missed_sessions || [];\n  const students = Array.isArray(inputs.students_json) ? inputs.students_json : [];\n  const spLinks = Array.isArray(inputs.sp_json) ? inputs.sp_json : [];\n  const parents = Array.isArray(inputs.parents_json) ? inputs.parents_json : [];\n\n  // Index students by id and batch_id\n  const studentById = {};\n  students.forEach(s => { studentById[s.id] = s; });\n\n  // Index parent by id\n  const parentById = {};\n  parents.forEach(p => { parentById[p.id] = p; });\n\n  // Build student -> parent map\n  const studentParentMap = {};\n  spLinks.forEach(sp => {\n    if (!studentParentMap[sp.student_id]) studentParentMap[sp.student_id] = [];\n    studentParentMap[sp.student_id].push(sp.parent_id);\n  });\n\n  // Resolve absent students with parent emails\n  const notifications = [];\n\n  missedSessions.forEach(missed => {\n    if (missed.type === 'one_on_one') {\n      const student = studentById[missed.student_id];\n      if (!student) return; // Skip unknown students\n\n      // Skip trial students — no alert needed\n      if (student.status === 'trial') return;\n\n      const parentIds = studentParentMap[missed.student_id] || [];\n      parentIds.forEach(pid => {\n        const parent = parentById[pid];\n        if (parent && parent.email) {\n          notifications.push({\n            student_id: missed.student_id,\n            student_name: student.name || 'Student',\n            parent_id: pid,\n            parent_email: parent.email,\n            parent_name: parent.name || 'Parent',\n            session_time: missed.start_time || '',\n            session_date: new Date().toISOString().split('T')[0]\n          });\n        }\n      });\n    } else if (missed.type === 'group') {\n      // For group sessions, find all students in the batch who have no attendance\n      const batchStudents = students.filter(s => s.batch_id === missed.batch_id);\n      batchStudents.forEach(student => {\n        if (student.status === 'trial') return; // Skip trial\n        // We don't individually check group attendance here — the triggers\n        // mark individual students. Alert for any missing group student.\n        // In production, add per-student attendance check.\n        const parentIds = studentParentMap[student.id] || [];\n        parentIds.forEach(pid => {\n          const parent = parentById[pid];\n          if (parent && parent.email) {\n            notifications.push({\n              student_id: student.id,\n              student_name: student.name || 'Student',\n              parent_id: pid,\n              parent_email: parent.email,\n              parent_name: parent.name || 'Parent',\n              session_time: missed.start_time || '',\n              session_date: new Date().toISOString().split('T')[0]\n            });\n          }\n        });\n      });\n    }\n  });\n\n  // Deduplicate by student_id\n  const seen = new Set();\n  const unique = notifications.filter(n => {\n    if (seen.has(n.student_id)) return false;\n    seen.add(n.student_id);\n    return true;\n  });\n\n  return {\n    notification_count: unique.length,\n    notifications: unique,\n    delay_hours: missedResult.delay_hours || 2\n  };\n};",
                            "packageJson": "{}"
                          },
