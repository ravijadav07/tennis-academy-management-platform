          "sourceCode": {
            "code": "export const code = async (inputs) => {\n  const p = typeof inputs.payload === 'string' ? JSON.parse(inputs.payload) : inputs.payload;\n  const name = (p.name || p.student_name || '').trim();\n  const phone = (p.phone || p.parent_phone || '').trim();\n  const email = (p.email || p.parent_email || '').trim();\n  const valid = name.length > 0 && (phone.length > 0 || email.length > 0);\n    const dupCheck = name.length > 0 && phone.length > 0 ? { name, phone } : null;\n  return {\n    valid: valid,\n    student_name: name,\n    student_age: p.age || p.student_age || '',\n    student_level: p.level || p.student_level || 'beginner',\n    parent_name: p.parent_name || name + \"'s Parent\",\n    parent_phone: phone,\n    parent_email: email,\n    entity: p.entity || 'tots-tennis',\n    batch_id: p.batch_id || '',\n    coach_id: p.coach_id || '',\n    plan_type: p.plan_type || 'Monthly',\n    amount: parseInt(p.amount || '0'),\n    start_date: p.start_date || new Date().toISOString().split('T')[0],\n    error: valid ? '' : 'Missing required fields: name and at least phone or email'\n  };\n};",
            "packageJson": "{}"
          },
