              "nextAction": {
                "name": "step_5",
                "type": "CODE",
                "displayName": "Filter Pending Balance > 0 & Resolve Recipients",
                "valid": true,
                "skip": false,
                "settings": {
                  "input": {
                    "packages_json": "{{step_1}}",
                    "students_json": "{{step_2}}",
                    "sp_json": "{{step_3}}",
                    "parents_json": "{{step_4}}"
                  },
                  "sourceCode": {
                    "code": "export const code = async (inputs) => {\n  const packages = Array.isArray(inputs.packages_json) ? inputs.packages_json : [];\n  const students = Array.isArray(inputs.students_json) ? inputs.students_json : [];\n  const spLinks = Array.isArray(inputs.sp_json) ? inputs.sp_json : [];\n  const parents = Array.isArray(inputs.parents_json) ? inputs.parents_json : [];\n\n  const studentById = {};\n  students.forEach(s => { studentById[s.id] = s; });\n  const parentById = {};\n  parents.forEach(p => { parentById[p.id] = p; });\n\n  const studentParentMap = {};\n  spLinks.forEach(sp => {\n    if (!studentParentMap[sp.student_id]) studentParentMap[sp.student_id] = [];\n    studentParentMap[sp.student_id].push(sp.parent_id);\n  });\n\n  const emails = [];\n  const skipped = [];\n\n  packages.forEach(p => {\n    const pending = (p.amount || p.finalAmount || 0) - (p.amountReceived || 0);\n    if (pending <= 0) { skipped.push({ packageId: p.id, reason: 'fully_paid' }); return; }\n    const student = studentById[p.studentId];\n    if (!student) { skipped.push({ packageId: p.id, reason: 'student_not_found' }); return; }\n    const parentIds = studentParentMap[student.id] || [];\n    if (parentIds.length === 0) { skipped.push({ packageId: p.id, studentId: student.id, reason: 'no_parent_linked' }); return; }\n    parentIds.forEach(pid => {\n      const parent = parentById[pid];\n      if (parent && parent.email) {\n        const hasUrl = !!p.paymentUrl;\n        const urlLine = hasUrl ? 'Payment Link: ' + p.paymentUrl : 'Payment link is not yet configured. Please contact the academy for payment details.';\n        emails.push({\n          studentId: student.id, studentName: student.name || 'Student',\n          parentEmail: parent.email, parentName: parent.name || 'Parent',\n          program: p.program || 'Enrollment', pendingAmount: pending,\n          subject: 'Payment Reminder - ' + student.name,\n          body: 'Dear Parent/Guardian,\\n\\nThis is a reminder that a payment is currently pending for ' + student.name + '.\\n\\nEnrollment: ' + (p.program || 'Enrollment') + '\\nPending Amount: Rs. ' + pending.toLocaleString('en-IN') + '\\n\\n' + urlLine + '\\n\\nRegards,\\nTennis Academy Management'\n        });\n      } else { skipped.push({ packageId: p.id, parentId: pid, reason: 'parent_email_missing' }); }\n    });\n  });\n  return { emails, skipped, reminderCount: emails.length, skippedCount: skipped.length };\n};",
                    "packageJson": "{}"
