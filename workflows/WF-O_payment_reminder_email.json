                      "sourceCode": {
                        "code": "export const code = async (inputs) => {\n  const step5 = inputs.step5 || {};\n  const llmOutput = inputs.llmOutput || '';\n  const target = step5.target || {};\n\n  // Clean LLM output — remove any markdown fences or preamble\n  let body = llmOutput;\n  const match = body.match(/[\\s\\S]*/);\n  if (match) body = match[0];\n  body = body.replace(/```[\\s\\S]*?```/g, '').trim();\n\n  return {\n    parentEmail: target.parentEmail || '',\n    parentName: target.parentName || 'Parent',\n    studentName: target.studentName || 'Student',\n    subject: step5.subject || 'Payment Reminder',\n    body: body || 'Dear Parent,\\n\\nThis is a payment reminder for your child\\'s tennis academy enrollment.\\n\\nRegards,\\nTennis Academy Management',\n    studentId: target.studentId || '',\n    packageId: target.packageId || '',\n    totalPending: step5.totalPending || 0\n  };\n};",
