# ============================================================================
# Tennis Academy Management — Environment Variables (Template)
# ============================================================================
# Copy this file to .env and fill in your actual values.
# .env is git-ignored — NEVER commit real credentials.
# ============================================================================

# ── Pucho AI Studio Workflow Webhooks ───────────────────────────────────────
VITE_MOCK_WEBHOOKS=false

# WF-P: Slot Report Email — generates & emails monthly slot analysis CSV
VITE_PUCHO_WF_SLOT_REPORT=https://studio.pucho.ai/api/v1/webhooks/YOUR_WEBHOOK_ID

# WF-M: Absence Alert Engine — detects absent students & notifies parents
VITE_PUCHO_WF_ABSENCE_ALERT=https://studio.pucho.ai/api/v1/webhooks/YOUR_WEBHOOK_ID

# WF-O: Payment Reminder Email — sends payment reminders to parents
VITE_PUCHO_WF_PAYMENT_REMINDER=https://studio.pucho.ai/api/v1/webhooks/YOUR_WEBHOOK_ID

# WF-I: Direct Payment Capture — processes payment webhooks & updates package status
VITE_PUCHO_WF_PAYMENT_CAPTURE=https://studio.pucho.ai/api/v1/webhooks/YOUR_WEBHOOK_ID

# WF-J: Club Excel Reconciliation — processes uploaded club attendance/payment excel sheets
VITE_PUCHO_WF_RECONCILIATION=https://studio.pucho.ai/api/v1/webhooks/YOUR_WEBHOOK_ID

# WF-E: Course Completion & Certificate — triggers course completion & certificate generation
VITE_PUCHO_WF_COURSE_COMPLETION=https://studio.pucho.ai/api/v1/webhooks/YOUR_WEBHOOK_ID

# WF-D: Student Onboarding — triggers onboarding sequence for newly enrolled students
VITE_PUCHO_WF_STUDENT_ONBOARDING=https://studio.pucho.ai/api/v1/webhooks/YOUR_WEBHOOK_ID

# WF-L: Coach Leave & Payroll — processes coach leave applications
VITE_PUCHO_WF_COACH_LEAVE=https://studio.pucho.ai/api/v1/webhooks/YOUR_WEBHOOK_ID
VITE_PUCHO_WF_COACH_PAYROLL=https://studio.pucho.ai/api/v1/webhooks/YOUR_WEBHOOK_ID

# WF-K: Invoice & Occupancy Report — generates invoice & occupancy reports
VITE_PUCHO_WF_INVOICE_OCCUPANCY=https://studio.pucho.ai/api/v1/webhooks/YOUR_WEBHOOK_ID
VITE_PUCHO_WF_INVOICE_REPORT=https://studio.pucho.ai/api/v1/webhooks/YOUR_WEBHOOK_ID

# ── Supabase Configuration ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Google Sheets Database Configuration ─────────────────────────────────────
VITE_GOOGLE_SHEETS_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
VITE_GOOGLE_SHEETS_GID_ACADEMIES=0
VITE_GOOGLE_SHEETS_GID_ATTENDANCE=YOUR_GID_ATTENDANCE
VITE_GOOGLE_SHEETS_GID_BATCHES=YOUR_GID_BATCHES
VITE_GOOGLE_SHEETS_GID_COACH_LEAVES=YOUR_GID_COACH_LEAVES
VITE_GOOGLE_SHEETS_GID_COACHES=YOUR_GID_COACHES
VITE_GOOGLE_SHEETS_GID_COURTS=YOUR_GID_COURTS
VITE_GOOGLE_SHEETS_GID_ENROLLMENTS=YOUR_GID_ENROLLMENTS
VITE_GOOGLE_SHEETS_GID_ONE_ON_ONE_SESSIONS=YOUR_GID_ONE_ON_ONE_SESSIONS
VITE_GOOGLE_SHEETS_GID_PACKAGES=YOUR_GID_PACKAGES
VITE_GOOGLE_SHEETS_GID_PARENTS=YOUR_GID_PARENTS
VITE_GOOGLE_SHEETS_GID_PAYMENTS=YOUR_GID_PAYMENTS
VITE_GOOGLE_SHEETS_GID_PROGRESS_REPORTS=YOUR_GID_PROGRESS_REPORTS
VITE_GOOGLE_SHEETS_GID_RECONCILIATION_AUDITS=YOUR_GID_RECONCILIATION_AUDITS
VITE_GOOGLE_SHEETS_GID_REPORT_VERIFICATIONS=YOUR_GID_REPORT_VERIFICATIONS
VITE_GOOGLE_SHEETS_GID_STUDENTS=YOUR_GID_STUDENTS

# ── App Configuration ───────────────────────────────────────────────────────
VITE_APP_NAME=Tennis Academy Management
VITE_APP_URL=http://localhost:5173
VITE_GST_RATE=0.18
